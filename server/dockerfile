FROM node:18-alpine

WORKDIR /app

# Copy dependency files
COPY package*.json ./
COPY prisma ./prisma

# Install deps
RUN npm install

# Generate Prisma Client
RUN npx prisma generate

# Copy source
COPY . .

# Build TypeScript
RUN npm run build

ENV PORT=3000
EXPOSE 3000

CMD ["npm", "run", "start"]
