FROM node:22-slim

# ---- System deps for Manim ----
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    ffmpeg \
    libcairo2-dev \
    pkg-config \
    pango1.0-tools \
    libpango1.0-dev \
    libpangocairo-1.0-0 \
    && rm -rf /var/lib/apt/lists/*

# ---- Install Manim (PEP 668 override) ----
RUN pip3 install --no-cache-dir manim --break-system-packages

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

ENV DATABASE_URL="postgresql://user:pass@localhost:5432/dummy"
RUN npx prisma generate

RUN npm run build

ENV PYTHON_PATH=python3
ENV NODE_ENV=production

EXPOSE 8080
CMD ["npm", "run", "start"]
