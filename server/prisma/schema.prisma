generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserPlan {
  TRIAL
  BASIC
  PRO
  UNLIMITED
}

enum LessonPlanStatus {
  DRAFT
  GENERATING
  READY
  FAILED
}

enum AssetStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

enum DaigramType {
  FLOWCHART
  GRAPH
  SEQUENCE
  ARCHITECHURE
  CUSTOM
}

enum ProgrammingLanguage {
  GO
  JAVASCRIPT
  PYTHON
  TYPESCRIPT
}

enum GradeLevel {
  BEGINNER
  INTERMEDIATE
  EXPERIENCE
}

enum LessonPlanType {
  GENERAL
  CODING
}

enum DiagramType {
  FLOWCHART
  GRAPH
  SEQUENCE
  ARCHITECTURE
  CUSTOM
}

enum UsageType {
  REALTIME_MINUTE
  DIAGRAM_GENERATED
  VIDEO_GENERATED
  TOKEN_USED
  CODE_EXECUTED
  CODE_GENERATED
}

model User {
  id       String   @id @default(uuid())
  email    String   @unique
  password String
  name     String?
  plan     UserPlan @default(TRIAL)

  creditBalance Float @default(0)

  // Aggregates (fast reads)
  usageSummary UsageSummary?

  lessonPlans LessonPlan[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  usageEvents UsageEvent[]
}

model UsageSummary {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  realtimeMinutes Int @default(0)
  diagrams        Int @default(0)
  videos          Int @default(0)
  tokens          Int @default(0)
  Code            Int @default(0)

  updatedAt DateTime @updatedAt
}

model UsageEvent {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type     UsageType
  amount   Int
  metadata Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
}

model LessonPlan {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type            LessonPlanType
  topic           String
  domain          String?
  confidenceLevel String?
  summary         String?

  gradeLevel GradeLevel

  programmingLanguage ProgrammingLanguage?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items LessonItem[]

  slides     Slide[]
  diagrams   Diagram[]
  animations Animation[]
  codes      Code[]

  @@index([userId])
}

enum LessonItemType {
  SLIDE
  DIAGRAM
  ANIMATION
  CODE
}

model LessonItem {
  id           String     @id @default(uuid())
  lessonPlanId String
  lessonPlan   LessonPlan @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)

  type  LessonItemType
  order Int

  slideId     String?
  diagramId   String?
  animationId String?
  codeId      String?

  createdAt DateTime @default(now())

  @@unique([lessonPlanId, order])
  @@index([lessonPlanId])
}

enum SlideType {
  NOTE
  SLIDE
}

model Slide {
  id           String     @id @default(uuid())
  lessonPlanId String
  lessonPlan   LessonPlan @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)

  title        String
  content      String?
  bulletPoints Json?
  tags         String[]
  type         SlideType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Diagram {
  id           String     @id @default(uuid())
  lessonPlanId String
  lessonPlan   LessonPlan @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)

  fileId      String?
  type        DiagramType
  title       String
  description String
  code        String
  metaData    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Animation {
  id           String     @id @default(uuid())
  lessonPlanId String
  lessonPlan   LessonPlan @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)

  fileId      String
  fileUrl     String
  metaData    Json?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Add model for saving coding questions 
model Code {
  id           String     @id @default(uuid())
  lessonPlanId String
  lessonPlan   LessonPlan @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)

  language    String
  explanation String
  code        String
}
