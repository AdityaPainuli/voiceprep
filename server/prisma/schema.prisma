generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserPlan {
  TRIAL
  BASIC
  PRO
  UNLIMITED
}

enum LessonPlanStatus {
  DRAFT
  GENERATING
  READY
  FAILED
}

enum AssetStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

enum DaigramType {
  FLOWCHART
  GRAPH
  SEQUENCE
  ARCHITECHURE
  CUSTOM
}

enum ProgrammingLanguage {
  GO
  JAVASCRIPT
  PYTHON
  TYPESCRIPT
}

enum GradeLevel {
  BEGINEER
  INTERMEDIATE
  EXPERIENCE
}

enum LessonPlanType {
  GENERAL
  CODING
}

enum DiagramType {
  FLOWCHART
  GRAPH
  SEQUENCE
  ARCHITECTURE
  CUSTOM
}

model User {
  id       String   @id @default(uuid())
  email    String   @unique
  password String
  name     String?
  plan     UserPlan @default(TRIAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  realtimeMinutesUsed Int @default(0)
  diagramsUsed        Int @default(0)
  videosUsed          Int @default(0)
  tokensUsed          Int @default(0)

  creditBalance Float @default(0)

  lessonPlans LessonPlan[]
}

model LessonPlan {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  type   LessonPlanType
  topic  String
  domain String?

  gradeLevel GradeLevel

  programmingLanguage ProgrammingLanguage?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items LessonItem[]

  slides     Slide[]
  diagrams   Diagram[]
  animations Animation[]

  @@index([userId])
}

enum LessonItemType {
  SLIDE
  DIAGRAM
  ANIMATION
}

model LessonItem {
  id           String     @id @default(uuid())
  lessonPlanId String
  lessonPlan   LessonPlan @relation(fields: [lessonPlanId], references: [id])

  type  LessonItemType
  order Int

  slideId     String?
  diagramId   String?
  animationId String?

  createdAt DateTime @default(now())

  @@unique([lessonPlanId, order])
  @@index([lessonPlanId])
}

enum SlideType {
  NOTE
  SLIDE
}

model Slide {
  id           String     @id @default(uuid())
  lessonPlanId String
  lessonPlan   LessonPlan @relation(fields: [lessonPlanId], references: [id])

  title        String
  content      String?
  bulletPoints Json?
  tags         String[]
  type         SlideType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Diagram {
  id           String     @id @default(uuid())
  lessonPlanId String
  lessonPlan   LessonPlan @relation(fields: [lessonPlanId], references: [id])

  fileId      String?
  type        DiagramType
  title       String
  description String
  code        String
  metaData    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Animation {
  id           String     @id @default(uuid())
  lessonPlanId String
  lessonPlan   LessonPlan @relation(fields: [lessonPlanId], references: [id])

  fileId      String
  fileUrl     String
  metaData    Json?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

